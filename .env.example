# Copy to .env.local and fill in. Never commit real values.

# ---------------------------------------------------------------------------
# Supabase — client-side. Safe to expose ONLY because RLS is correct.
# docs/01-architecture.md ranks RLS gaps as the #1 attack surface.
#
# For the local stack: run `supabase start`, then `supabase status -o env`
# and copy the values it prints. They are regenerated per machine, so they
# are not hardcoded here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Read by the content sync script and the RLS test suite, which are not
# Next.js and so do not see NEXT_PUBLIC_ vars automatically. Same values.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase — SERVER ONLY. Never prefix with NEXT_PUBLIC_, never import into a
# client component. Used by Edge Functions and the content sync script.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Google OAuth. Referenced by supabase/config.toml. Leave empty and the
# provider is configured but every sign-in attempt fails at Google — email and
# password still work, which is what the test suite covers.
# ---------------------------------------------------------------------------
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Analytics and errors.
#
# All optional. Unset means analytics and error reporting are off, which is the
# correct state locally and in CI — a test run should not fill the production
# funnel or the production issue list.
#
# The three NEXT_PUBLIC_ values belong on Vercel. The Sentry build values are
# only read during `next build`; without them Sentry still captures every error,
# the stack traces just point at minified output.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=

# Build-time only: source-map upload. Token needs project:releases and org:read.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Production (.env.production.local, gitignored — NOT this file)
#
# `supabase db push` and `pnpm content:sync --confirm-remote` read SUPABASE_URL,
# SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY from there. The service role
# key bypasses RLS and is deliberately absent from Vercel: the app never uses
# it, only the sync script does. See docs/07-operations.md.
# ---------------------------------------------------------------------------

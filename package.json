{
  "name": "poker-trainer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@poker/web",
    "build": "turbo run build",
    "test": "vitest run",
    "test:engine": "vitest --project engine",
    "test:engine:exhaustive": "ENGINE_ORACLE_HANDS=1000000 vitest run --project engine evaluator.oracle",
    "test:e2e": "playwright test",
    "test:db": "pnpm --filter @poker/scripts run test:db",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase migration up --local",
    "db:reset": "supabase db reset --local && pnpm content:sync",
    "db:test": "supabase test db supabase/tests/database",
    "content:sync": "pnpm --filter @poker/scripts run sync"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
